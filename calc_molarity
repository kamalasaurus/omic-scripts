#!/usr/bin/env Rscript

# calc_molarity.R
# Calculates DNA molarity (nM) from concentration (ng/µL) and fragment length (bp).
# Usage: Rscript calc_molarity.R <conc_ng_per_uL> <length_bp>
# Example: Rscript calc_molarity.R 170.8 1767

# Read command-line arguments
args <- commandArgs(trailingOnly = TRUE)
if (length(args) != 2) {
  cat("Usage: calc_molarity.R <ng_per_uL> <bp>\n")
  quit(status = 1)
}

# Parse inputs
conc_ng_per_uL <- as.numeric(args[1])
length_bp      <- as.numeric(args[2])

if (is.na(conc_ng_per_uL) || is.na(length_bp) || length_bp <= 0) {
  cat("Error: both arguments must be numeric, and bp > 0.\n")
  quit(status = 1)
}

# Constants
avg_bp_mass <- 660    # average g/mol per base-pair (dsDNA)
conv_factor <- 1e6    # to convert (ng/µL)/(g/mol·bp) to nM

# Calculation
molarity_nM <- (conc_ng_per_uL * conv_factor) / (avg_bp_mass * length_bp)

# Output
cat(sprintf("Concentration: %.1f ng/µL\n", conc_ng_per_uL))
cat(sprintf("Length:        %d bp\n", length_bp))
cat(sprintf("Molarity:      %.1f nM\n", molarity_nM))
