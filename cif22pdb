#!/usr/bin/env python
import sys
import os
from Bio.PDB import MMCIFParser, PDBIO

def main():
    if len(sys.argv) < 2:
        print("Usage: {} <input_file.cif>".format(os.path.basename(sys.argv[0])))
        sys.exit(1)

    input_file = sys.argv[1]
    if not input_file.lower().endswith('.cif'):
        print("Error: Input file must have a .cif extension.")
        sys.exit(1)

    basename = os.path.splitext(os.path.basename(input_file))[0]
    output_file = basename + ".pdb"

    # Parse the CIF file
    parser = MMCIFParser(QUIET=True)
    try:
        structure = parser.get_structure(basename, input_file)
    except Exception as e:
        print("Error parsing CIF file: ", e)
        sys.exit(1)

    # Write the structure to a PDB file
    io = PDBIO()
    io.set_structure(structure)
    try:
        io.save(output_file)
    except Exception as e:
        print("Error writing PDB file: ", e)
        sys.exit(1)

    print("Successfully converted {} to {}".format(input_file, output_file))

if __name__ == "__main__":
    main()
