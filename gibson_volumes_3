#!/usr/bin/env Rscript

# gibson_volumes.R
# Calculates µL volumes for a 1:1:1 Gibson assembly at a specified pmol per fragment.
# Adds a scaled volume column where the smallest volume is set to 1 µL (others rounded up proportionally),
# and prints the new pmol delivered after scaling.

# Usage: gibson_volumes.R <conc1_nM> <conc2_nM> <conc3_nM> [desired_pmol]
# Example: gibson_volumes.R 146.5 96.8 78.5    # defaults to 0.05 pmol

args <- commandArgs(trailingOnly = TRUE)
if (length(args) < 3 || length(args) > 4) {
  cat("Usage: gibson_volumes.R <conc1_nM> <conc2_nM> <conc3_nM> [desired_pmol]\n")
  quit(status = 1)
}

concs_nM     <- as.numeric(args[1:3])
desired_pmol <- ifelse(length(args) == 4, as.numeric(args[4]), 0.05)
if (any(is.na(concs_nM)) || is.na(desired_pmol) || desired_pmol <= 0) {
  cat("Error: all concentrations must be numeric and desired pmol > 0\n")
  quit(status = 1)
}

# Conversion: 1 nM = 0.001 pmol/µL
concs_pmol_per_uL <- concs_nM / 1000

# Calculate actual volumes (µL) needed
volumes_uL <- desired_pmol / concs_pmol_per_uL

# Scale volumes so the smallest becomes 1 µL
min_vol        <- min(volumes_uL)
rel_volumes    <- volumes_uL / min_vol
scaled_volumes <- ceiling(rel_volumes)

# Compute new pmol delivered with scaled volumes
new_pmol <- concs_pmol_per_uL * scaled_volumes

# Output results
cat(sprintf("Target per fragment: %.3f pmol\n\n", desired_pmol))
for (i in seq_along(concs_nM)) {
  cat(sprintf(
    "Fragment %d: %5.1f nM → %6.3f pmol/µL → %6.3f µL → scaled: %d µL → new: %.3f pmol\n",
    i, concs_nM[i], concs_pmol_per_uL[i], volumes_uL[i], scaled_volumes[i], new_pmol[i]
  ))
}

sprintf("Total pmol:  %.3f pmol", sum(new_pmol))
